---
import { getRelativeLocaleUrl } from 'astro:i18n'
import type { Locale } from '../core/locale'
import { sections } from '../data/sections'
import { t } from '../data/ui-strings'

interface Props {
  locale: Locale
  currentSlug?: string
  titles: Readonly<Record<string, string>>
}

const { locale, currentSlug, titles } = Astro.props
const glossaryHref = getRelativeLocaleUrl(locale, 'glossary')
const examHref = getRelativeLocaleUrl(locale, 'exam')
const homeHref = getRelativeLocaleUrl(locale, '')
---

<nav class="text-sm" aria-label={t(locale, 'nav.contents')} data-sidebar data-locale={locale}>
  <p class="mb-4">
    <a href={homeHref} class="font-semibold hover:underline">
      {t(locale, 'nav.home')}
    </a>
  </p>
  <details open data-toc>
    <summary class="mb-3 cursor-pointer font-semibold uppercase tracking-wide text-slate-500">
      {t(locale, 'nav.contents')}
    </summary>
    <ol class="space-y-1">
      {sections.map((section) => {
        const title = titles[section.slug]
        const isAvailable = title !== undefined
        const isCurrent = section.slug === currentSlug
        const href = getRelativeLocaleUrl(locale, `section/${section.slug}`)

        return (
          <li data-section-id={section.sectionId}>
            {isAvailable ? (
              <a
                href={href}
                aria-current={isCurrent ? 'page' : undefined}
                class:list={['hover:underline', isCurrent && 'font-semibold']}
              >
                {section.order}. {title}
              </a>
            ) : (
              <span class="text-slate-400">{section.order}</span>
            )}
            <span class="ml-1 inline-flex gap-1 align-middle" data-marks></span>
          </li>
        )
      })}
    </ol>
    <p class="mt-4 border-t border-slate-200 pt-4 dark:border-slate-800">
      <a href={glossaryHref} class="hover:underline">
        {t(locale, 'nav.glossary')}
      </a>
    </p>
    <p class="mt-2">
      <a href={examHref} class="hover:underline">
        {t(locale, 'nav.exam')}
      </a>
    </p>
  </details>
</nav>

<script>
  import { isLocale } from '../core/locale'
  import { readProgress, sectionMarks } from '../core/progress'
  import { wireTocToggle } from '../core/toc'
  import { t } from '../data/ui-strings'

  function makeMark(glyph: string, label: string): HTMLElement {
    const span = document.createElement('span')
    span.textContent = glyph
    span.setAttribute('role', 'img')
    span.setAttribute('aria-label', label)
    span.title = label
    return span
  }

  const nav = document.querySelector<HTMLElement>('[data-sidebar]')
  const locale = nav?.dataset.locale

  if (nav && locale && isLocale(locale)) {
    const progress = readProgress(window.localStorage)

    nav.querySelectorAll<HTMLElement>('[data-section-id]').forEach((item) => {
      const sectionId = item.dataset.sectionId
      const marksContainer = item.querySelector<HTMLElement>('[data-marks]')
      if (!sectionId || !marksContainer) return

      const marks = sectionMarks(progress, sectionId)
      if (marks.read) marksContainer.appendChild(makeMark('✓', t(locale, 'progress.read')))
      if (marks.quizzed) marksContainer.appendChild(makeMark('◆', t(locale, 'progress.quizzed')))
    })
  }

  const details = nav?.querySelector<HTMLDetailsElement>('[data-toc]')

  if (details) {
    const isNarrowViewport = !window.matchMedia('(min-width: 1024px)').matches
    wireTocToggle(details, window.localStorage, isNarrowViewport)
  }
</script>
